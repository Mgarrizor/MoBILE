# This Makefile does not need dependency files
# to build the program in the proper order. This is,
# dependencies between modules have been manually written.
# Once executed, dependency files will be generated and a
# second Makefile can use them. 
#=================
# Do not touch these lines!
.DELETE_ON_ERROR:                     # Delete target file if recipe has an error
.SUFFIXES:                            # No implicit rules
FC        := $(shell nf-config --fc)  # FORTRAN compiler (gfortran)
MAIN      := ./src/mobile.f90         # Main program file
SRC_DIR   := ./src      # Location of source code
OBJ_DIR   := ./obj      # Location of objects (not in use right now)
BUILD_DIR := ./build    # Location to build the program
DEP_DIR   := ./dep      # Location of dependency files (not in use right now)
#-------------------------------------------------
INC_FLAGS := $(shell nf-config --fflags)  # Flags needed to compile a FORTRAN program (NetCDF)
#INC_LIBS  := $(shell nf-config --flibs)   # Libraries needed to link a FORTRAN program (NetCDF)
INC_LIBS  := -L/opt/homebrew/Cellar/netcdf_both/lib -lnetcdff -lnetcdf -lnetcdf
#-------------------------------------------------
DEBUG     := -Og -fbacktrace -Wall -fcheck=all -ffixed-line-length-none #(https://stackoverflow.com/questions/3676322/what-flags-to-set-for-gfortran-compiler-to-catch-faulty-code)
FAST      := #-O3        # Optimization flag (https://gcc.gnu.org/onlinedocs/gcc/Optimize-Options.html)
EXE       := mobile.out # Name of executable file

#===== Will create the following hierarchy in the folder were is run
#
#         |-src (source code)
# build --
#         |-obj (objects and mod files)
#
# mobile.out
#
#=================================================

# Declare SOURCE files =======================
# Find all the F90 (and C?) files we want to compile
# Note the single quotes around the * expressions. 
# The shell will incorrectly expand these otherwise, 
# but we want to send the * directly to the find command.
SRCS := $(shell find -L $(SRC_DIR) -name '*.f90')# -or -name '*.c')

DEPS := ./src/mo_control.f90 ./src/mo_const.f90
MOD0 := $(filter-out $(DEPS) $(MAIN),$(SRCS))
# Filter out main file (mobile.f90) and then substitute suffix		
MOD1 := $(filter-out $(MOD0) $(MAIN),$(SRCS))	
#MOD1:= $(FILTERED:%=$(BUILD_DIR)/%)
MOD2:= $(addprefix $(strip $(BUILD_DIR))/,$(MOD0:./src/%.f90=%.o))
MOD3:= $(addprefix $(strip $(BUILD_DIR))/,$(MOD1:./src/%.f90=%.o))

#DEPENDS := $(patsubs %.o,%.d,$(MOD2))
DEPENDS := $(MOD2:%.o=%.d) \
		   $(MOD3:%.o=%.d)

# $(addprefix $(strip $(DEP_DIR))/,$(MOD2:./src/%.f90=%.o))
           
#=============================================

# Declare OBJECTS to be generated ============
# String substitution
# reference: https://www.gnu.org/software/make/manual/html_node/Text-Functions.html#Text-Functions
# Nomenclature: $(text:pattern=replacement)


#OBJS := $(SRCS:%=$(BUILD_DIR)/%.o)
#MOD  := $(SRCS:%=$(BUILD_DIR)/%.o)
OBJS := $(addprefix $(strip $(BUILD_DIR))/,$(SRCS:./src/%.f90=%.o))

# Runs last
# Does "nothing" but it actually generates the 
# executable (.out) file by triggering the chain 
# of rules written below
# Look for $(EXE)!
all: $(EXE)
	@echo 'Successful compilation'
# Corrected! Used to be inside 'all'. If we move them then, 'make' 
# will recompile everything again even if not new. It is better to create 
# them directly in their  eventual folder --> we do this by adding the 
# folder hierarchy to their string name. Source, object and mod files
# should not be moved from the place where 'make' looks for them!
#@mkdir -p $(BUILD_SRC_DIR)
#@mkdir -p $(BUILD_OBJ_DIR)
#@mv *.o $(BUILD_OBJ_DIR)
#@mv $(strip $(BUILD_DIR))/*.mod $(BUILD_OBJ_DIR)
#@cp $(strip $(SRC_DIR))/*.f90 $(BUILD_SRC_DIR)

# Runs third
# Linking step
# Requires object file of main
# source file (mobile.f90), mobile.o
$(EXE): ./build/mobile.o
	@echo '2.- Link step'
	@$(FC) $(OBJS) -fbackslash -o $(EXE) $(INC_LIBS) $(DEBUG) $(FAST)

# Runs second
# Generate main object file only if module object files or
# main source file are newer than main object.
# Look for module source files and module objects
./build/mobile.o: $(MOD2) $(MOD3) $(MAIN)
	@echo '1.- Compile main' $(MAIN)
	@$(FC) -c $(MAIN) -I $(BUILD_DIR) -o $@ $(INC_FLAGS) $(DEBUG) $(FAST)

# Runs first

# Compile module only if its .f90 source
# file and the dependencies, $(MOD3) are 
# newer than the corresponding object file, $(MOD2)
$(MOD2): ./build/%.o : ./src/%.f90 $(MOD3)
	@echo '0.- Compile module' $<
	@mkdir -p $(BUILD_DIR)
	@$(FC) -cpp -MD -c $< -J $(BUILD_DIR) -o $@ $(INC_FLAGS) $(DEBUG) $(FAST)


# Core dependencies 
$(MOD3): ./build/%.o : ./src/%.f90 
	@echo '0.- Compile module' $<
	@mkdir -p $(BUILD_DIR)
	@$(FC) -cpp -MD -c $< -J $(BUILD_DIR) -o $@ $(INC_FLAGS) $(DEBUG) $(FAST)




.PHONY: clean   # Reconfigure hw prerequisite for 'clean' target is treated
	            # i.e., always run 'make clean' even if a 'clean' file exists
clean:
	rm -rf ${DIR} *.o *.out




